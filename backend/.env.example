# =============================================================================
# FounderOS AI — Backend Environment Variables
# =============================================================================
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# In production (Replit Deployments, Docker, CI), set these as real environment
# variables / secrets — DO NOT commit a real `.env` file.
# Process env vars always take priority over the `.env` file.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="FounderOS AI"
APP_VERSION="1.0.0"
PORT=8000
DEBUG=false
ENVIRONMENT=development             # development | staging | production
SECRET_KEY=change-me-in-production  # generate via `openssl rand -hex 32`

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only key — never expose to the browser.
# Either name is accepted; SUPABASE_SERVICE_KEY is the canonical one.
SUPABASE_SERVICE_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # legacy alias, also accepted

# ── CORS ─────────────────────────────────────────────────────────────────────
# Localhost + Replit domains are added automatically. Add any extras here,
# comma-separated, e.g. "https://app.example.com,https://staging.example.com"
EXTRA_CORS_ORIGINS=

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
